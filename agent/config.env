# config.env
# SmartDNS Log Agent 配置文件

# 节点配置
NODE_ID=1
NODE_NAME=node-1

# 审计日志文件路径
LOG_FILE=/var/log/smartdns/audit.log

# 可选：仅为新日志写入静态映射匹配标记，原始日志及历史记录保持不变
STATIC_ADDRESS_TAGGING=false
SMARTDNS_CONFIG_FILE=/etc/smartdns/smartdns.conf
# 启用时设置固定的 RFC3339 起始时间；留空则使用进程启动时间
STATIC_ADDRESS_TAG_FROM=

# 批处理配置
BATCH_SIZE=1000
FLUSH_INTERVAL_SEC=2

# ClickHouse 配置
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=smartdns_logs
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
